# Copy to your process environment (or a secrets manager). All values are optional for local demo use.
PORT=3000
PUBLIC_URL=http://localhost:3000          # use https://… in production (enables Secure cookies + HSTS)
ADMIN_EMAIL=admin@medtranslate.local
ADMIN_PASSWORD=                          # if empty, a random password is printed on first start
MEDIA_SIGNING_SECRET=                    # if empty, generated and stored in data/.secrets.json

# AI translation (Anthropic Claude). Without a key, translations can only be imported/edited manually.
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-opus-5-5

# Payments (Stripe Checkout). Without keys the platform runs in labelled demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Operator details for Impressum / legal texts (placeholders are shown until set)
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_REPRESENTATIVE=
OPERATOR_EMAIL=
OPERATOR_PHONE=
OPERATOR_REGISTER=
OPERATOR_VAT_ID=
OPERATOR_DPO=

# Launch focus: only courses filed under this specialty are public ('' = all specialties).
# If unset, the admin setting (Admin → Specialties & providers → Launch focus) is used; default: emergency-medicine.
LAUNCH_FOCUS=

# Planner e-mail reminders (Resend, https://resend.com). Without a key, reminders are only stored in Admin → Outbox, never sent.
RESEND_API_KEY=
MAIL_FROM=MedTranslate <reminders@your-verified-domain.tld>

# Launch languages: comma list of public languages ('*' = all). If unset, the admin setting is used;
# default = established languages (en, fr, es, pt, de, ar) + Nigeria (ha, yo, ig, pcm) + Kenya (sw).
LAUNCH_LANGUAGES=
