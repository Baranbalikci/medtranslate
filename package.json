{
  "name": "medtranslate",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered multilingual medical education (CME/CPD) platform \u2014 subtitles, AI dubbing and compliance-gated publishing.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/server.js",
    "media": "node tools/slides/render-slides.mjs",
    "reset-db": "node --disable-warning=ExperimentalWarning tools/reset-db.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "build:static": "node --disable-warning=ExperimentalWarning tools/build-static.mjs"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "*"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
