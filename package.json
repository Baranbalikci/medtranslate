{
  "name": "medtranslate",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered multilingual medical education (CME/CPD) platform — subtitles, AI dubbing and compliance-gated publishing.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/server.js",
    "media": "node tools/generate-media.mjs",
    "reset-db": "node --disable-warning=ExperimentalWarning tools/reset-db.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "*"
  }
}
